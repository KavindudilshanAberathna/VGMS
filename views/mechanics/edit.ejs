<h2>Edit Mechanic</h2>
<form method="POST" action="/mechanics/edit/<%= mechanic._id %>">
  <label>Full Name:</label>
  <input type="text" name="fullName" value="<%= mechanic.fullName %>" required><br>
  <label>Email:</label>
  <input type="email" name="email" value="<%= mechanic.email %>" required><br>
  <button type="submit">Update</button>
</form>
