<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Invoice</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-30deg);
      font-size: 6rem;
      color: rgba(128, 0, 0, 0.05);
      font-weight: 900;
      z-index: 0;
      pointer-events: none;
    }

    .footer {
      text-align: center;
      font-size: 12px;
      color: #666;
      margin-top: 60px;
      border-top: 1px solid #ccc;
      padding-top: 10px;
    }
    @media print {
      .no-print { display: none; }
    }
  </style>
</head>
<body class="bg-gray-50 p-10 text-gray-900 font-sans relative">

  <!-- Watermark -->
  <div class="watermark select-none">PAID</div>

  <!-- Invoice Container -->
  <div class="bg-white shadow-md rounded-xl p-8 max-w-3xl mx-auto relative z-10 border border-gray-200">
    
    <!-- Header -->
    <div class="flex justify-between items-center border-b pb-4 mb-6">
      <div>
        <h1 class="text-3xl font-bold text-[#800000]">VGMS</h1>
        <p class="text-sm text-gray-500">Vehicle Garage Management System</p>
      </div>
      <div class="text-right">
        <h1 class="text-3xl font-bold">Invoice</h1>
        <p class="text-sm text-gray-500"><%= new Date(transaction.paidAt).toLocaleDateString() %></p>
      </div>
    </div>

    <!-- Customer Info -->
    <div class="mb-6">
      <h2 class="text-lg font-semibold text-[#800000] mb-2">Customer Info</h2>
      <div class="grid grid-cols-2 gap-4 text-sm">
        <p><strong>Name:</strong> <%= transaction.customerName %></p>
        <p><strong>Vehicle No:</strong> <%= transaction.vehicleNumber %></p>
        <p><strong>Service Type:</strong> <%= transaction.serviceType %></p>
        <p><strong>Mechanic:</strong> <%= transaction.mechanicName %></p>
      </div>
    </div>

    <!-- Service Info -->
    <div class="mb-6">
      <h2 class="text-lg font-semibold text-[#800000] mb-2">Service Details</h2>
      <div class="grid grid-cols-2 gap-4 text-sm">
        <p><strong>Start:</strong> <%= transaction.startDate.toDateString() %> at <%= transaction.startTime %></p>
        <p><strong>End:</strong> <%= transaction.endDate.toDateString() %> at <%= transaction.endTime %></p>
        <p><strong>Duration:</strong> <%= transaction.durationText %></p>
        <p><strong>Status:</strong> 
          <span class="inline-block px-2 py-1 text-xs font-semibold text-white bg-green-600 rounded-full">
            <%= transaction.status %>
          </span>
        </p>
      </div>
    </div>

    <!-- Payment Info -->
    <div class="mb-8">
      <h2 class="text-lg font-semibold text-[#800000] mb-2">Payment Info</h2>
      <table class="w-full text-sm border border-gray-300 rounded-lg overflow-hidden">
        <thead class="bg-[#800000] text-white">
          <tr>
            <th class="text-left px-4 py-2">Method</th>
            <th class="text-left px-4 py-2">Amount</th>
            <th class="text-left px-4 py-2">Paid At</th>
          </tr>
        </thead>
        <tbody>
          <tr class="bg-gray-50">
            <td class="px-4 py-2 border-t"><%= transaction.method %></td>
            <td class="px-4 py-2 border-t">Rs. <%= transaction.amount.toLocaleString() %></td>
            <td class="px-4 py-2 border-t"><%= new Date(transaction.paidAt).toLocaleString() %></td>
          </tr>
        </tbody>
      </table>
    </div>

   <div class="footer">
    Thank you for choosing our garage!<br>
    Address: 123 Main Street, City, Country | Phone: (123) 456-7890 | Email: garage@example.com
  </div>
  </div>

  
</body>
</html